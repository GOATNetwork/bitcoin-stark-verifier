+/// The coordinate representation of a field element.
+fn representation(x: EF) -> u128 {
+    u128::from_le_bytes(
+        crate::packing::coordinate_bytes(core::slice::from_ref(&x))
+            .try_into()
+            .expect("sixteen bytes"),
+    )
+}
