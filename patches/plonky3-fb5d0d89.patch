+            challenger,
+            self.shape(),
+        );
+        let points = self.reductions.iter().map(BitRingSwitch::point).collect::<Vec<_>>();
+        let mu = transcript.merged_points(&points)?;
+        let weights = claim_weights(mu, expected);
