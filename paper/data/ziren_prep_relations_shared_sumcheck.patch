+/// whir-gc experiment: how many preprocessed values a verifier needs once the
+/// fixed trace's exact linear relations are used.  Per table: the GF(2) rank of
+/// the preprocessed columns (the all-ones column known), and the rank over F of
+/// the table's preprocessed forms written over that column basis.
+fn prep_rank(machine: &TapeMachine) {
+    use p3_air::BaseAir;
+    use p3_binary_field::TowerLevel;
+    use p3_field::{Field, PrimeCharacteristicRing};
+    type Fb = zkm_binary_stark::F;
+    let (mut total_now, mut total_rank) = (0usize, 0usize);
+    for air in machine.airs() {
+        let Some(trace) = BaseAir::<Fb>::preprocessed_trace(air) else { continue };
+        let width = trace.width;
+        let rows = trace.values.len() / width;
+        let words = rows.div_ceil(64);
+        let column = |c: usize| -> Vec<u64> {
+            let mut bits = vec![0u64; words];
+            for r in 0..rows {
+                let v = trace.values[r * width + c];
+                assert!(v == Fb::ZERO || v == Fb::ONE, "a preprocessed cell is a bit");
+                if v == Fb::ONE {
+                    bits[r / 64] |= 1 << (r % 64);
+                }
+            }
+            bits
+        };
+        // Basis vectors in echelon form, each with its combination of original
+        // columns (bit `width` is the all-ones column).
+        let combo_words = (width + 1).div_ceil(64);
+        let mut basis: Vec<(usize, Vec<u64>, Vec<u64>)> = Vec::new();
+        let mut ones = vec![u64::MAX; words];
+        if rows % 64 != 0 {
+            ones[words - 1] = (1u64 << (rows % 64)) - 1;
+        }
+        let mut chosen: Vec<usize> = Vec::new(); // original columns in the basis
+        // Express every column over the chosen originals and the ones column.
+        let mut expressed: Vec<Vec<u64>> = vec![Vec::new(); width];
+        let candidates = std::iter::once(width).chain(0..width);
+        for c in candidates {
+            let mut v = if c == width { ones.clone() } else { column(c) };
+            let mut combo = vec![0u64; combo_words];
+            combo[c / 64] |= 1 << (c % 64);
+            for (pivot, bvec, bcombo) in &basis {
+                if v[pivot / 64] >> (pivot % 64) & 1 == 1 {
+                    for (x, y) in v.iter_mut().zip(bvec) {
+                        *x ^= y;
+                    }
+                    for (x, y) in combo.iter_mut().zip(bcombo) {
+                        *x ^= y;
+                    }
+                }
+            }
+            match v.iter().position(|&w| w != 0) {
+                Some(word) => {
+                    let pivot = word * 64 + v[word].trailing_zeros() as usize;
+                    // Keep earlier vectors reduced at the new pivot.
+                    for (_, bvec, bcombo) in basis.iter_mut() {
+                        if bvec[pivot / 64] >> (pivot % 64) & 1 == 1 {
+                            for (x, y) in bvec.iter_mut().zip(&v) {
+                                *x ^= y;
+                            }
+                            for (x, y) in bcombo.iter_mut().zip(&combo) {
+                                *x ^= y;
+                            }
+                        }
+                    }
+                    basis.push((pivot, v, combo.clone()));
+                    if c < width {
+                        chosen.push(c);
+                        let mut own = vec![0u64; combo_words];
+                        own[c / 64] |= 1 << (c % 64);
+                        expressed[c] = own;
+                    }
+                }
+                None => {
+                    // combo XORs to zero: column c is the sum of the others in it.
+                    if c < width {
+                        let mut rest = combo.clone();
+                        rest[c / 64] &= !(1 << (c % 64));
+                        expressed[c] = rest;
+                    }
+                }
+            }
+        }
+        // Each column over the chosen originals; the ones column's value is known.
+        let index: std::collections::HashMap<usize, usize> =
+            chosen.iter().enumerate().map(|(i, &c)| (c, i)).collect();
+        let forms = BaseAir::<Fb>::preprocessed_linear_forms(air);
+        let form_vectors: Vec<Vec<(usize, Fb)>> = match &forms {
+            Some(lf) => lf.forms.iter().map(|f| f.iter().map(|&(c, x)| (c, Fb::from_repr(x))).collect()).collect(),
+            None => (0..width).map(|c| vec![(c, Fb::ONE)]).collect(),
+        };
+        let mut matrix: Vec<Vec<Fb>> = Vec::new();
+        for form in &form_vectors {
+            let mut row = vec![Fb::ZERO; chosen.len()];
+            for &(c, x) in form {
+                for o in 0..width {
+                    if expressed[c][o / 64] >> (o % 64) & 1 == 1 {
+                        row[index[&o]] += x;
+                    }
+                }
+            }
+            matrix.push(row);
+        }
+        // Rank over F.
+        let mut rank = 0;
+        let cols = chosen.len();
+        for col in 0..cols {
+            let Some(p) = (rank..matrix.len()).find(|&r| matrix[r][col] != Fb::ZERO) else { continue };
+            matrix.swap(rank, p);
+            let inv = matrix[rank][col].inverse();
+            let pivot_row: Vec<Fb> = matrix[rank].iter().map(|x| *x * inv).collect();
+            for r in 0..matrix.len() {
+                if r != rank && matrix[r][col] != Fb::ZERO {
+                    let f = matrix[r][col];
+                    for (x, y) in matrix[r].iter_mut().zip(&pivot_row) {
+                        *x -= f * *y;
+                    }
+                }
+            }
+            matrix[rank] = pivot_row;
+            rank += 1;
+        }
+        // What the verifier reads today: forms (or columns) not over constant columns only.
+        let varies: Vec<bool> = (0..width)
+            .map(|c| (1..rows).any(|r| trace.values[r * width + c] != trace.values[c]))
+            .collect();
+        let now = form_vectors.iter().filter(|f| f.iter().any(|&(c, _)| varies[c])).count();
+        eprintln!(
+            "{:>7}: {width} preprocessed columns, GF(2) rank {} (with the ones column), {} forms, {now} read today, {rank} independent over the column basis",
+            air.name(), basis.len(), form_vectors.len()
+        );
+        total_now += now;
+        total_rank += rank;
+    }
+    eprintln!("preprocessed values read today {total_now}; needed with the fixed relations {total_rank}");
+}
