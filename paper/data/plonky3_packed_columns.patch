+/// Values a proof carries on a route: per column, or per batched run's wire layout.
+pub(super) fn wire_value_count(route: &OpeningRoute, protocol: &OpeningProtocol) -> usize {
+    match route {
+        OpeningRoute::Batched(runs) => runs
+            .iter()
+            .map(|run| run.shape.values_per_batch() * run.shape.num_batches)
+            .sum(),
+        OpeningRoute::PerColumn(_) => value_count(protocol),
+    }
+}
+
+/// whir-gc experiment: the coordinate basis `e_k` a packed group is read through.
+pub(super) fn packing_basis<EF: BitCoordinates>() -> Vec<EF> {
+    (0..EF::DIMENSION)
+        .map(|k| {
+            EF::from_coordinate_bytes(
+                (0..EF::DIMENSION / 8).map(|byte| if byte == k / 8 { 1u8 << (k % 8) } else { 0 }),
+            )
+        })
+        .collect()
+}
+
+/// The values a packed batch binds: each column outside a group, and each group packed,
+/// in column order.
+pub(super) fn packed_forms<EF: Field>(columns: &[EF], groups: &[(usize, usize)], basis: &[EF]) -> Vec<EF> {
+    let mut forms = Vec::new();
+    let mut column = 0;
+    for &(first, len) in groups {
+        forms.extend_from_slice(&columns[column..first]);
+        forms.push(
+            columns[first..first + len]
+                .iter()
+                .zip(basis)
+                .map(|(&value, &e)| e * value)
+                .sum(),
+        );
+        column = first + len;
+    }
+    forms.extend_from_slice(&columns[column..]);
+    forms
+}
+
+/// The weight of each column slot under `rho`: form `j` weighs its column by `rho^j`, or
+/// its group's columns by `rho^j * e_k`.  Slots past the width weigh nothing.
+pub(super) fn packed_weights<EF: Field>(
+    width: usize,
+    groups: &[(usize, usize)],
+    basis: &[EF],
+    rho: EF,
+) -> Vec<EF> {
+    let mut weights = alloc::vec![EF::ZERO; width.next_power_of_two()];
+    let mut power = EF::ONE;
+    let mut column = 0;
+    let plain = |weights: &mut Vec<EF>, from: usize, to: usize, power: &mut EF| {
+        for weight in &mut weights[from..to] {
+            *weight = *power;
+            *power *= rho;
+        }
+    };
+    for &(first, len) in groups {
+        plain(&mut weights, column, first, &mut power);
+        for (k, weight) in weights[first..first + len].iter_mut().enumerate() {
+            *weight = power * basis[k];
+        }
+        power *= rho;
+        column = first + len;
+    }
+    plain(&mut weights, column, width, &mut power);
+    weights
+}
+
+/// Columns that pack to the forms: each column outside a group as sent, a group's first
+/// column `e_0^{-1}` times its packed value, the rest zero.  An AIR reading the group only
+/// packed evaluates them as it would the committed columns.
+pub(super) fn expand_forms<EF: Field>(
+    forms: &[EF],
+    width: usize,
+    groups: &[(usize, usize)],
+    basis: &[EF],
+) -> Vec<EF> {
+    let mut columns = Vec::with_capacity(width);
+    let mut forms = forms.iter();
+    let e0 = basis[0].inverse();
+    for &(first, len) in groups {
+        columns.extend(forms.by_ref().take(first - columns.len()).copied());
+        let packed = *forms.next().expect("one form per group");
+        columns.push(e0 * packed);
+        columns.resize(first + len, EF::ZERO);
+    }
+    columns.extend(forms.copied());
+    debug_assert_eq!(columns.len(), width);
+    columns
+}
+
+/// The per-column values a proof's wire values stand for, in protocol order.
+pub(super) fn column_values<EF: BitCoordinates>(route: &OpeningRoute, values: &[EF]) -> Vec<EF> {
+    let OpeningRoute::Batched(runs) = route else {
+        return values.to_vec();
+    };
+    if runs.iter().all(|run| run.packed.is_empty()) {
+        return values.to_vec();
+    }
+    let basis = packing_basis::<EF>();
+    let mut columns = Vec::with_capacity(values.len());
+    let mut rest = values;
+    for run in runs {
+        let per_batch = run.shape.values_per_batch();
+        for _ in 0..run.shape.num_batches {
+            let (batch, tail) = rest.split_at(per_batch);
+            rest = tail;
+            if run.packed.is_empty() {
+                columns.extend_from_slice(batch);
+            } else {
+                columns.extend(expand_forms(
+                    &batch[..run.shape.forms],
+                    run.shape.width,
+                    &run.packed,
+                    &basis,
+                ));
+            }
+        }
+    }
+    columns
+}
